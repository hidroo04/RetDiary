# Environment variables — RetDiary Backend
# Copy file ini ke .env dan isi sesuai konfigurasi lokal Anda
# cp .env.example .env

# ─── DATABASE ────────────────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME?schema=public
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/retdiary?schema=public"

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Ganti dengan string acak yang panjang dan aman di production
JWT_SECRET="ganti_dengan_secret_yang_kuat_dan_panjang"
JWT_EXPIRES_IN="7d"

# ─── SERVER ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# CORS — origin yang diizinkan (pisahkan dengan koma jika lebih dari satu)
CORS_ORIGIN=http://localhost:5173
